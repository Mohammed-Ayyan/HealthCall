# HealthCall / CareOps AI - Frontend Environment Configuration
# Duplicate this file to .env.local and populate with your Supabase credentials:

# Supabase Project URL (e.g. https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anonymous API Key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here
